    <packagedElement xmi:type="uml:Package" xmi:id="_qv7ecLHLEeyg4O17VpKoOg" name="Imports">
      <packageImport xmi:type="uml:PackageImport" xmi:id="_dbG9wLQNEeyJfJau7v0yoQ">
        <importedPackage xmi:type="uml:Model" href="CommonDataTypes/ImplementationCommonDataTypes.uml#_-lRh4FDNEeWpFusmeDrF3w"/>
      </packageImport>
      <packageImport xmi:type="uml:PackageImport" xmi:id="_lZ_SsHOZEei917Wc41N11A">
        <importedPackage xmi:type="uml:Package" href="../OnfModel/CoreModel.uml#_oGqilVLNEeO75dO39GbF8Q"/>
      </packageImport>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="_9ObaELHLEeyg4O17VpKoOg" name="Interfaces">
      <packagedElement xmi:type="uml:Interface" xmi:id="_BbIJENYiEe6lRtOWHyVSkw" name="SynchronizationFcOperations">
        <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJEdYiEe6lRtOWHyVSkw" annotatedElement="_BbIJENYiEe6lRtOWHyVSkw">
          <body>Group of operations (e.g. RPCs on NETCONF interfaces), which are effective on the Synchronization Selectors.</body>
        </ownedComment>
        <ownedOperation xmi:type="uml:Operation" xmi:id="_BbIJEtYiEe6lRtOWHyVSkw" name="createSynchronizationFcPort" concurrency="concurrent">
          <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJE9YiEe6lRtOWHyVSkw" annotatedElement="_BbIJEtYiEe6lRtOWHyVSkw">
            <body>Adds a Synchronization interface to an already existing Selector (SynchronizationFc). The references of the Selector (SynchronizationFc) and the to be connected Synchronization interface must be provided as input. The following error-messages are to be send, if the operation would fail: #[onf:Referenced object is invalid.]#, if the referenced ForwardingConstruct or LogicalTerminationPoint does not exist or does not belong to the Synchronization layer. #[onf:Synchronization interface cannot be added.]#, if the referenced Synchronization interface cannot be added to the referenced Selector (SynchronizationFc).</body>
          </ownedComment>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_BbIJFNYiEe6lRtOWHyVSkw" name="_affectedSynchronizationFc">
            <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJFdYiEe6lRtOWHyVSkw" annotatedElement="_BbIJFNYiEe6lRtOWHyVSkw">
              <body>Reference of the Selector (SynchronizationFc), which shall connect the additional Synchronization interface (LTP).</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_oGqmC1LNEeO75dO39GbF8Q"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_BbIJFtYiEe6lRtOWHyVSkw" name="_associatedSynchronizationInterface">
            <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJF9YiEe6lRtOWHyVSkw" annotatedElement="_BbIJFtYiEe6lRtOWHyVSkw">
              <body>Reference of the Synchronization interface (LTP), which shall be connected with the Selector (SynchronizationFc).</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_BSoNANYlEe6lRtOWHyVSkw" name="fcPortDirection" isUnique="false">
            <ownedComment xmi:type="uml:Comment" xmi:id="_fUQ_MNYmEe6lRtOWHyVSkw" annotatedElement="_BSoNANYlEe6lRtOWHyVSkw">
              <body>INPUT is identifying a source of the Synchronization signal. OUTPUT is identifying either an external connector, or this network element's clock or an internal reference point between Selectors.</body>
            </ownedComment>
            <type xmi:type="uml:Enumeration" href="../OnfModel/CoreModel.uml#_2WpC8EC7EeWxhL2B6Peg6A"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_VZGBcNYkEe6lRtOWHyVSkw" name="synchronizationSourcePriority" isUnique="false">
            <ownedComment xmi:type="uml:Comment" xmi:id="_fAOTwNYkEe6lRtOWHyVSkw" annotatedElement="_VZGBcNYkEe6lRtOWHyVSkw">
              <body>Only relevant, if fcPortDirection==INPUT. Configurable priority of a source. Values will be transferred into synchronizationSourcePriority attribute at the FcPort object at an FordwardingConstruct with layerProtocolName == LAYER_PROTOCOL_NAME_TYPE_SYNCHRONIZATION_LAYER.</body>
            </ownedComment>
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_iVjQ0NYkEe6lRtOWHyVSkw"/>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_iVrMoNYkEe6lRtOWHyVSkw" value="1"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_BbIJGNYiEe6lRtOWHyVSkw" name="_createdSynchronizationFcPort" direction="out" effect="read">
            <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJGdYiEe6lRtOWHyVSkw" annotatedElement="_BbIJGNYiEe6lRtOWHyVSkw">
              <body>localId of the SynchronizationFcPort (either newly created or already existing) that is connecting the Synchronization interface (LTP) with the Selector (SynchronizationFc).</body>
            </ownedComment>
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          </ownedParameter>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="_BbIJGtYiEe6lRtOWHyVSkw" name="deleteSynchronizationFcPort" concurrency="concurrent">
          <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJG9YiEe6lRtOWHyVSkw" annotatedElement="_BbIJGtYiEe6lRtOWHyVSkw">
            <body>Removes a Synchronization interface (LTP) from an existing Selector (SynchronizationFc). References to the Selector (SynchronizationFc) and the to be disconnected Synchronization interface (LTP) must be provided as input. The following error-messages are to be send, if the operation would fail: #[onf:Referenced object is invalid.]#, if the referenced ForwardingConstruct or LogicalTerminationPoint does not exist or does not belong to the Synchronization layer. #[onf:Synchronization interface cannot be disconnected.]#, if the referenced Synchronization interface (LTP) cannot be removed from the referenced Selector (SynchronizationFc).</body>
          </ownedComment>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_BbIJHNYiEe6lRtOWHyVSkw" name="_affectedSynchronizationFc" effect="delete">
            <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJHdYiEe6lRtOWHyVSkw" annotatedElement="_BbIJHNYiEe6lRtOWHyVSkw">
              <body>Reference to the Selector (SynchronizationFc), which shall no longer be connected with the Synchronization interface (LTP), which is also provided as input.</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_oGqmC1LNEeO75dO39GbF8Q"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_BbIJHtYiEe6lRtOWHyVSkw" name="_obsoleteSynchronizationInterface" effect="delete">
            <ownedComment xmi:type="uml:Comment" xmi:id="_BbIJH9YiEe6lRtOWHyVSkw" annotatedElement="_BbIJHtYiEe6lRtOWHyVSkw">
              <body>Reference to the Synchronization interface (LTP), which shall no longer be connected with the Selector (SynchronizationFc), which is also provided as input.</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          </ownedParameter>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="_b1IBUGenEfCH2tS52OWB5Q" name="createPtpLtp" concurrency="concurrent">
          <ownedComment xmi:type="uml:Comment" xmi:id="_b1IBUWenEfCH2tS52OWB5Q" annotatedElement="_b1IBUGenEfCH2tS52OWB5Q">
            <body>Adds a PTP interface to the device. The following error-messages are to be send, if the operation would fail: #[onf:Referenced object is invalid.]#, if the referenced LogicalTerminationPoint or Clock does not exist or does not belong to the EthernetContainer layer. #[onf:Resources not available.]#, if the PTP LTP cannot be created as the maximum number of PTP interfaces already exists. #[onf:PTP interface cannot be provided.]#, if the PTP LTP does not already exist and cannot be created.</body>
          </ownedComment>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_b1IBVGenEfCH2tS52OWB5Q" name="_servingLtp" isUnique="false">
            <ownedComment xmi:type="uml:Comment" xmi:id="_b1IBVWenEfCH2tS52OWB5Q" annotatedElement="_b1IBVGenEfCH2tS52OWB5Q">
              <body>Reference to the server layer LTP.</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_vk6N8IfNEfCfc7tIGSVucA" name="_ptpClock" isUnique="false">
            <ownedComment xmi:type="uml:Comment" xmi:id="_clMwwIfPEfCfc7tIGSVucA" annotatedElement="_vk6N8IfNEfCfc7tIGSVucA">
              <body>Reference to the PTP clock.</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_8lP6kHXAEeeqyuooNTTDCg"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_PYpyMGeqEfCH2tS52OWB5Q" name="_createdLtp" direction="out" effect="read">
            <ownedComment xmi:type="uml:Comment" xmi:id="_PYpyMWeqEfCH2tS52OWB5Q" annotatedElement="_PYpyMGeqEfCH2tS52OWB5Q">
              <body>UUID of the PTP LTP that has either been newly created or was already existing.</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          </ownedParameter>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="_aThu4GerEfCH2tS52OWB5Q" name="deletePtpLtp" concurrency="concurrent">
          <ownedComment xmi:type="uml:Comment" xmi:id="_aThu4WerEfCH2tS52OWB5Q" annotatedElement="_aThu4GerEfCH2tS52OWB5Q">
            <body>Removes a PTP interface from the device. The following error-messages are to be send, if the operation would fail: #[onf:Referenced object is invalid.]#, if the referenced LogicalTerminationPoint does not belong to the PTP layer. #[onf:PTP interface cannot be disconnected.]#, if the referenced PTP interface (LTP) cannot be removed from the Clock.</body>
          </ownedComment>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_aThu5GerEfCH2tS52OWB5Q" name="_obsoletePtpLtp" isUnique="false" effect="delete">
            <ownedComment xmi:type="uml:Comment" xmi:id="_aThu5WerEfCH2tS52OWB5Q" annotatedElement="_aThu5GerEfCH2tS52OWB5Q">
              <body>Reference to the PTP LTP, which shall no longer exist on the device.</body>
            </ownedComment>
            <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          </ownedParameter>
        </ownedOperation>
      </packagedElement>
    </packagedElement>
