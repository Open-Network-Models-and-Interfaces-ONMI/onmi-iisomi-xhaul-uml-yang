            <body>The profile currently in use: Must be in the list of supported profiles</body>
          </ownedComment>
          <defaultValue xmi:type="uml:InstanceValue" xmi:id="_DBQFMA5OEe2eOJKy3IpAMA" type="_TQgz0AJNEeegkdv_tKLxWg" instance="_LxzjkA5IEe2eOJKy3IpAMA"/>
        </ownedAttribute>
