            <body>The PTP status dataset of internal transparent clock of the NE.</body>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_r6-MEKmpEfCEoMlKBe9kDw" name="bmcaIsOn" isUnique="false">
