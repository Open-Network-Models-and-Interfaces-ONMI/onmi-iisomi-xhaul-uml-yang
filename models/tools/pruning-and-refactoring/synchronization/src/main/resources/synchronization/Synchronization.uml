          <defaultValue xmi:type="uml:InstanceValue" xmi:id="_c1ffUA5OEe2eOJKy3IpAMA" type="_RXmxcAJNEeegkdv_tKLxWg" instance="_KYm8AA5IEe2eOJKy3IpAMA"/>
