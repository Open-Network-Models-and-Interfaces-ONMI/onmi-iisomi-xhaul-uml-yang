          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_MTDQkPa8EeyyycMeYJ5w0A" value="-1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_aNW04B-9Ee6rC95eXsecCQ" name="timeSource" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_aNW04R-9Ee6rC95eXsecCQ" annotatedElement="_aNW04B-9Ee6rC95eXsecCQ">
            <body>Values to be set according to table 7 in section 7.6.2.6 of IEEE 1588-2008.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_aNW04h-9Ee6rC95eXsecCQ" value="-1"/>
        </ownedAttribute>
