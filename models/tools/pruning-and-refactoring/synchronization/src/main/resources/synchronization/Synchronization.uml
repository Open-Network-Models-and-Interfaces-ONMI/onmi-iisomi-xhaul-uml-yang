          <defaultValue xmi:type="uml:InstanceValue" xmi:id="_CXY-YlDMEfCaWbZLxWVKpQ" type="_RXmxcAJNEeegkdv_tKLxWg" instance="_KYm8AA5IEe2eOJKy3IpAMA"/>
