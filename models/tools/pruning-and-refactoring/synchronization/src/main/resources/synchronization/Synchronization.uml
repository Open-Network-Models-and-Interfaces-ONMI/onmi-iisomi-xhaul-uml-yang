        <ownedAttribute xmi:type="uml:Property" xmi:id="_b1P9wg68Ee6RhaGPt0mq5w" name="_phaseAlignedClock" type="_6zZMcF2UEey8G-Opn_XBlg" aggregation="shared" association="_b1PWsA68Ee6RhaGPt0mq5w">
