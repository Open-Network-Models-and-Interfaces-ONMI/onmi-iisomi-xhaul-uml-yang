            <body>SSM quality level that is currently received at the port (if ssmMode==automatic) or manually configured in ssmConfigurationValue (if ssmMode==manual).</body>
          </ownedComment>
          <defaultValue xmi:type="uml:InstanceValue" xmi:id="_WqyQkA5OEe2eOJKy3IpAMA" type="_RXmxcAJNEeegkdv_tKLxWg" instance="_KYm8AA5IEe2eOJKy3IpAMA"/>
