      <packagedElement xmi:type="uml:Class" xmi:id="_QhAI4AeYEeeSr90X-zum4Q" name="SyncProtectionSpec">
        <ownedComment xmi:type="uml:Comment" xmi:id="_HOmEYAfPEeexrILJlIcylA" annotatedElement="_QhAI4AeYEeeSr90X-zum4Q">
          <body>Sync protection schema parameters spec for ControlParameter_Pac of C&amp;SC. The Synchronization protection model follows the concepts and models of the ONF-CoreModel. The Synchronization Protection Specification class extends the CoreModel:ControlParameters_Pac with synchronization specific parameters. The CoreModel defines for protection cases a forwarding-construct (FC) with a forwarding-construct-switch (FC-Switch) object class. The FC-Switch object class directly within the FC is main scope of the synchronization protection of Microwave devices. Therefore, the ConfiguationAndSwitchControl list (C&amp;SC) is out of scope of this specification and does not need to be implemented. The FC defines pointers (FC-Port) to the participants of the synchronization protection – mainly to the logical termination point (LTP) representing the optional clock sources. The currently selected clock source parameter of the SyncProtectionSpec object class points also to an LTP, if the selection process is not failing. In case the selection process has failed the currently selected clock parameter must not be exposed in the management interface.</body>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_GiXd4PqhEeuL-allgzaGLA" name="_currentSourcePort" isUnique="false" isReadOnly="true" aggregation="shared" association="_GiI0YPqhEeuL-allgzaGLA">
          <ownedComment xmi:type="uml:Comment" xmi:id="_LozMMPqhEeuL-allgzaGLA" annotatedElement="_GiXd4PqhEeuL-allgzaGLA">
            <body>The ID of the port traced by the system clock currently.</body>
          </ownedComment>
          <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_qbXZ4AqbEe6T1_a93NHyjg"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_qcBhMAqbEe6T1_a93NHyjg" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_mzGaUPqhEeuL-allgzaGLA" name="_systemClockSourcePriorityList" isUnique="false" aggregation="shared" association="_mzBh0PqhEeuL-allgzaGLA">
          <ownedComment xmi:type="uml:Comment" xmi:id="_p9FDAPqhEeuL-allgzaGLA" annotatedElement="_mzGaUPqhEeuL-allgzaGLA">
            <body>The list is used to select clock port. It is composed of clock port IDs in the order of priorities.</body>
          </ownedComment>
          <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_veljwPqhEeuL-allgzaGLA"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_vfHvQPqhEeuL-allgzaGLA" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_fd37YAeZEeeSr90X-zum4Q" name="SsmEnableStatus" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_RBhXAAfPEeexrILJlIcylA" annotatedElement="_fd37YAeZEeeSr90X-zum4Q">
            <body>In automatic reference selection process, if SSM is enabled, the selection of clock source is performed based on SSM and priority; otherwise the selection depends on priority only.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
          <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_7_f0MPw6EeykMPnLzNNALQ"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_f8GIcAeZEeeSr90X-zum4Q" name="UnkStatus" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_R9XUMAfPEeexrILJlIcylA" annotatedElement="_f8GIcAeZEeeSr90X-zum4Q">
            <body>Indicate whether to take UNK as one of the SSM quality levels or not. If UNK is enabled, its level lies between PRC and SSU_T; otherwise it is taken as DNU.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
          <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_9u3gEPw6EeykMPnLzNNALQ"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_2S_20fqhEeuL-allgzaGLA" name="_externalClockSourcePriorityList" isUnique="false" isReadOnly="true" aggregation="shared" association="_2S-osPqhEeuL-allgzaGLA">
          <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_48JDUPqhEeuL-allgzaGLA"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_48bXMPqhEeuL-allgzaGLA" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_fAKREMAlEe6sbtMm7qoLWg" name="systemClockSourcePriorityList" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_fAKREcAlEe6sbtMm7qoLWg" annotatedElement="_fAKREMAlEe6sbtMm7qoLWg">
            <body>The list defines the rank of the individual clock ports.</body>
          </ownedComment>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_ybfBUMAlEe6sbtMm7qoLWg"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_yblH8MAlEe6sbtMm7qoLWg" value="*"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_jf8VMNunEe6bM_MNwxuYmg" name="SyncFcPortSpec">
        <ownedAttribute xmi:type="uml:Property" xmi:id="_1S4TQMRbEfC8yrmCyIRNdg" name="syncLtpsAvailableForConnecting" isUnique="false" isReadOnly="true" aggregation="shared" association="_1Q0dwMRbEfC8yrmCyIRNdg">
          <ownedComment xmi:type="uml:Comment" xmi:id="_mFBzkMRcEfC8yrmCyIRNdg" annotatedElement="_1S4TQMRbEfC8yrmCyIRNdg">
            <body>Sub-group of synchronization LTPs that are available for being connected by this FcPort. Empty list (equals the attribute not existing on the NETCONF interface) means that all synchronization LTPs referenced by the ForwardingDomain are also available for being connected by this FcPort.</body>
          </ownedComment>
          <type xmi:type="uml:Class" href="../OnfModel/CoreModel.uml#_eEpDMFX4EeOVGaP4lO41SQ"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_4paxQMRbEfC8yrmCyIRNdg"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_4piGAMRbEfC8yrmCyIRNdg" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_9hekcNunEe6bM_MNwxuYmg" name="synchronizationSourcePriority" isUnique="false" isReadOnly="true">
          <ownedComment xmi:type="uml:Comment" xmi:id="_Rvv_INupEe6bM_MNwxuYmg" annotatedElement="_9hekcNunEe6bM_MNwxuYmg">
            <body>Configurable priority of a source. Values are to be interpreted in accordance with the definitions made in chapter 5.10 of ITU-T Rec. G781.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          <defaultValue xmi:type="uml:LiteralString" xmi:id="_eeAjoOBNEe6EUumbgYGlmA" value="-1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_lQ6akOXOEe6S9rtzlJcx0Q" name="ssmBasedClockDirectionIsAvail" isUnique="false" isReadOnly="true">
          <ownedComment xmi:type="uml:Comment" xmi:id="_lQ6akeXOEe6S9rtzlJcx0Q" annotatedElement="_lQ6akOXOEe6S9rtzlJcx0Q">
            <body>If true, the device supports the clock direction being determined by SSM protocol, if enabled by ssmBasedClockDirectionIsOn attribute.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
          <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_lQ6akuXOEe6S9rtzlJcx0Q"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_YwqmEOXOEe6S9rtzlJcx0Q" name="ssmBasedClockDirectionIsOn" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_YwqmEeXOEe6S9rtzlJcx0Q" annotatedElement="_YwqmEOXOEe6S9rtzlJcx0Q">
            <body>If true, this parameter allows the clock direction on the 1Gbit/s electrical interface to be automatically chosen by the SSM protocol to avoid loops.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
          <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_YwqmEuXOEe6S9rtzlJcx0Q"/>
        </ownedAttribute>
      </packagedElement>
    </packagedElement>
