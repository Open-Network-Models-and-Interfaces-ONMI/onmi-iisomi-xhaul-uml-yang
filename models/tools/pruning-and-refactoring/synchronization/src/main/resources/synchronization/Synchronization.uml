      <packagedElement xmi:type="uml:Enumeration" xmi:id="_uFTgUAOEEe2YD6yYu6RXIA" name="PtpMulticastAddresses">
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_-tsO4AOEEe2YD6yYu6RXIA" name="01-80-C2-00-00-0E">
          <ownedComment xmi:type="uml:Comment" xmi:id="_-tsO4QOEEe2YD6yYu6RXIA" annotatedElement="_-tsO4AOEEe2YD6yYu6RXIA">
            <body>Frames get dropped at intermediate switches.</body>
          </ownedComment>
        </ownedLiteral>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_D0nscAOFEe2YD6yYu6RXIA" name="01-1B-19-00-00-00">
          <ownedComment xmi:type="uml:Comment" xmi:id="_D0nscQOFEe2YD6yYu6RXIA" annotatedElement="_D0nscAOFEe2YD6yYu6RXIA">
            <body>Frames get forwarded at intermediate switches.</body>
          </ownedComment>
        </ownedLiteral>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_Yb4rYAOFEe2YD6yYu6RXIA" name="00-00-00-00-00-00"/>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="_I0MUAAJPEeegkdv_tKLxWg" name="PtpMacEncapsulation">
        <ownedAttribute xmi:type="uml:Property" xmi:id="_NohcsAeUEeeSr90X-zum4Q" name="destinationMacAddress" type="_uFTgUAOEEe2YD6yYu6RXIA" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_m8bHMAOGEe2YD6yYu6RXIA" annotatedElement="_NohcsAeUEeeSr90X-zum4Q">
            <body>The destinationMacAddress attribute defines the destination mac address, which is attached to the PTP packet, while it gets handed over to the Ethernet MAC Layer for being transmitted. According to ITU-T G8275.1 section 6.2.6 and Appendix III and IEEE 1588-2008 F.3, one out of two multicast addresses can be chosen. The two addresses differ by behavior on intermediate switches, which do not operate PTP. Frames with 01-80-C2-00-00-0E may get dropped at intermediate switches. Frames with 01-1B-19-00-00-00 get forwarded.</body>
          </ownedComment>
          <defaultValue xmi:type="uml:InstanceValue" xmi:id="_ctPy4AOFEe2YD6yYu6RXIA" type="_uFTgUAOEEe2YD6yYu6RXIA" instance="_Yb4rYAOFEe2YD6yYu6RXIA"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_RLbiwAeUEeeSr90X-zum4Q" name="vlanId" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_8gyDMAc5Ee2cFuKsJOqYPA" annotatedElement="_RLbiwAeUEeeSr90X-zum4Q">
            <body>If set on values between 1 and 4094, PTP frames get amended by a VLAN header including the chosen VLAN ID.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_UhRdMAc5Ee2cFuKsJOqYPA" value="-1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_LrTuoAnuEe6pIPuP0jFAVw" name="priority" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_LrTuoQnuEe6pIPuP0jFAVw" annotatedElement="_LrTuoAnuEe6pIPuP0jFAVw">
            <body>p-bit setting at the Ethernet frames for transporting the PTP messages.</body>
          </ownedComment>
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_LrTuognuEe6pIPuP0jFAVw" value="-1"/>
        </ownedAttribute>
      </packagedElement>
