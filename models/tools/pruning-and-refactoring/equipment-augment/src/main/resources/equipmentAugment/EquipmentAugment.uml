    <packagedElement xmi:type="uml:Package" xmi:id="_nzCdQl9LEemkV8c3A5D8-A" name="Interfaces">
      <packagedElement xmi:type="uml:Interface" xmi:id="_MxzvcJQhEe6T1JKVGp5mTg" name="EquipmentOperations">
        <ownedOperation xmi:type="uml:Operation" xmi:id="_SBybUJQhEe6T1JKVGp5mTg" name="restart">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_SBybVJQhEe6T1JKVGp5mTg" name="kindOfRestart" type="_vRCjwJQhEe6T1JKVGp5mTg" isUnique="false">
            <ownedComment xmi:type="uml:Comment" xmi:id="_SBybVZQhEe6T1JKVGp5mTg" annotatedElement="_SBybVJQhEe6T1JKVGp5mTg">
              <body>For distinguishing traffic affecting and non-traffic affecting restart.</body>
            </ownedComment>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_SBybUpQhEe6T1JKVGp5mTg" name="affectedComponentPath" type="_r-OdQJQjEe6T1JKVGp5mTg" isUnique="false">
            <ownedComment xmi:type="uml:Comment" xmi:id="_CIqCoJQlEe6T1JKVGp5mTg" annotatedElement="_SBybUpQhEe6T1JKVGp5mTg">
              <body>Path to the Equipment object that shall be restarted. If some top level equipment would be referenced, the entire device might be restarted.</body>
            </ownedComment>
          </ownedParameter>
        </ownedOperation>
      </packagedElement>
    </packagedElement>
