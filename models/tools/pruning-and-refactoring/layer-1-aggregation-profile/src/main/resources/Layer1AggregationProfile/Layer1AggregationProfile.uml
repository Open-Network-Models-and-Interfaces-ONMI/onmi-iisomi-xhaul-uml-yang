  <uml:Model xmi:id="_Imk30GyUEee0HrHFgb9oqw" name="Layer1AggregationProfile" URI="">
    <ownedComment xmi:type="uml:Comment" xmi:id="_Vz0nAKSCEemZx_PrWGDYjw" annotatedElement="_Imk30GyUEee0HrHFgb9oqw">
